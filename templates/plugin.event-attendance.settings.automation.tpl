<div class="accordion-item"><form {foreach $attributes as $attribute}{$attribute@key}="{$attribute}" {/foreach}>{include 'sys-template-parts/form.input.tpl' data=$elements['adm_csrf_token']}<h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#automation">{$l10n->get('PLG_EVENT_ATTENDANCE_TRACKER_SETTINGS_AUTOMATION')}</button></h2><div id="automation" class="accordion-collapse collapse" data-bs-parent="#adm_event_attendance_settings_accordion"><div class="accordion-body">{include 'sys-template-parts/form.select.tpl' data=$elements['event_attendance_automation_method']}<div id="event_attendance_automation_cli_section">{include 'sys-template-parts/form.custom-content.tpl' data=$elements['event_attendance_automation_cli']}</div><div id="event_attendance_automation_webcron_section">{include 'sys-template-parts/form.input.tpl' data=$elements['event_attendance_webcron_token']}{include 'sys-template-parts/form.custom-content.tpl' data=$elements['event_attendance_automation_webcron']}</div><div id="event_attendance_automation_status_section">{include 'sys-template-parts/form.custom-content.tpl' data=$elements['event_attendance_automation_status']}</div>{include 'sys-template-parts/form.button.tpl' data=$elements['adm_button_save_event_attendance']}</div></div></form></div>
<script>$(function () { const updateAutomation = function () { const method = $('#event_attendance_automation_method').val(); $('#event_attendance_automation_cli_section').toggle(method === 'cli'); $('#event_attendance_automation_webcron_section').toggle(method === 'webcron'); $('#event_attendance_automation_status_section').toggle(method !== 'disabled'); }; $('#event_attendance_automation_method').on('change', updateAutomation); updateAutomation(); $('[data-copy-automation-command]').on('click', function () { const button = $(this); const command = button.siblings('[data-automation-command]').text(); const initialContent = button.html(); if (!navigator.clipboard) { return; } navigator.clipboard.writeText(command).then(function () { button.html('<i class="bi bi-clipboard-check"></i>'); window.setTimeout(function () { button.html(initialContent); }, 1500); }).catch(function () {}); }); });</script>
