<div class="accordion-item"><h2 class="accordion-header" id="management_heading"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#management" aria-expanded="false">{$l10n->get('SYS_EVENT_ATTENDANCE_PLUGIN_MANAGEMENT')}</button></h2><div id="management" class="accordion-collapse collapse" aria-labelledby="management_heading"><div class="accordion-body">
    <p>{$pluginDescription|escape}</p><dl class="row"><dt class="col-sm-3">{$l10n->get('SYS_EVENT_ATTENDANCE_AUTHOR')}</dt><dd class="col-sm-9"><a href="https://github.com/MightyMCoder" target="_blank" rel="noopener">MightyMCoder</a></dd><dt class="col-sm-3">{$l10n->get('SYS_VERSION')}</dt><dd class="col-sm-9"><code>{$installedVersion|escape}</code></dd></dl>
    <div id="adm_event_attendance_update_status" class="alert alert-{if $updateAvailable}warning{else}success{/if}">{if $updateAvailable}{$l10n->get('SYS_EVENT_ATTENDANCE_UPDATE_AVAILABLE')}{else}{$l10n->get('SYS_EVENT_ATTENDANCE_UP_TO_DATE')}{/if}</div>
    <button id="adm_event_attendance_check_update" class="btn btn-outline-secondary mb-3" type="button"><i class="bi bi-arrow-clockwise"></i> {$l10n->get('SYS_CHECK_FOR_UPDATE')}</button>
    <form class="d-inline" method="post" action="{$updateUrl|escape}"><input type="hidden" name="adm_csrf_token" value="{$csrfToken|escape}"><button class="btn btn-secondary mb-3" type="submit"><i class="bi bi-arrow-repeat"></i> {$l10n->get('SYS_EVENT_ATTENDANCE_PERFORM_UPDATE')}</button></form>
    <form class="d-inline" method="post" action="{$uninstallUrl|escape}"><input type="hidden" name="adm_csrf_token" value="{$csrfToken|escape}"><button class="btn btn-danger mb-3" type="submit"><i class="bi bi-trash-fill"></i> {$l10n->get('SYS_EVENT_ATTENDANCE_UNINSTALL')}</button></form>
</div></div></div>
<script>$('#adm_event_attendance_check_update').on('click', function () { $.post('{$checkUpdateUrl|escape:'javascript'}', { adm_csrf_token: '{$csrfToken|escape:'javascript'}' }, function (data) { $('#adm_event_attendance_update_status').removeClass('alert-success alert-warning').addClass(data.updateAvailable ? 'alert-warning' : 'alert-success').text(data.message); }); });</script>
